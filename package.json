{
  "name": "bito-desktop",
  "version": "0.5.1",
  "private": true,
  "description": "Bito — a thoughtful desktop companion",
  "author": "Bito Project",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1",
    "postinstall": "node scripts/assets.mjs",
    "build": "node scripts/assets.mjs && tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "backend:login": "supabase login",
    "backend:deploy": "supabase functions deploy bito-api --use-api",
    "backend:check": "npx --yes deno check supabase/functions/bito-api/index.ts",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@rive-app/canvas": "2.45.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "id.bito.companion",
    "productName": "Bito",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "identity": "-",
      "icon": "public/icon.png",
      "artifactName": "Bito-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Bito-${version}-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/icon.png"
    }
  },
  "type": "module"
}
